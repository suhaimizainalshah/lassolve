{
  "manifest_version": 3,
  "name": "Lassolve: Screenshot, Screen Recorder and Data Extractor",
  "short_name": "Lassolve",
  "version": "1.4.0",
  "description": "Capture screenshots, record your screen, and extract tables, media and text from any page. Private: runs on your device.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/suhaimizainalshah/Lassolve",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lassolve",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Lassolve"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Capture an area"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture the full page"
    },
    "scrape-page": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Scrape data from the page"
    }
  },
  "omnibox": {
    "keyword": "lasso"
  }
}